# ============================================================
#  RxScreen (on-prem) — ค่าเชื่อมต่อฐานข้อมูล รพ.
#  ** ส่วนนี้ให้ IT เป็นผู้กรอก — คัดลอกเป็น .env.hospital แล้วเติมค่า **
#  ระบบทำงานแบบ "อ่านอย่างเดียว + รันในเครื่อง" ไม่ส่งข้อมูลออกภายนอก
# ============================================================

# ── ฐานข้อมูล HOSxP (MySQL / MariaDB) ────────────────────────
# แนะนำให้ชี้ไปที่ "ฐานสำรอง/replica/report DB" ไม่ใช่ตัว production หลัก
HOSPITAL_DB_HOST=              # IP หรือ hostname ของ MySQL  เช่น 10.10.1.25
HOSPITAL_DB_PORT=3306
HOSPITAL_DB_NAME=              # ชื่อฐาน เช่น hos / hosxp_pcu
HOSPITAL_DB_USER=rxscreen_ro   # user อ่านอย่างเดียว (ดูสคริปต์ hosxp_readonly.sql)
HOSPITAL_DB_PASSWORD=          # รหัสผ่านของ user นี้ (เก็บในเครื่องเท่านั้น)
HOSPITAL_DB_CHARSET=tis620     # HOSxP ใช้ tis620 (ภาษาไทย) — อย่าเปลี่ยนถ้าไม่แน่ใจ
HOSPITAL_DB_TIMEZONE=+07:00
HOSPITAL_DB_CONNECT_TIMEOUT=8  # วินาที
HOSPITAL_DB_MAX_CONNECTIONS=4  # จำกัด connection กันภาระฐาน
HOSPITAL_DB_QUERY_TIMEOUT=10   # ตัด query ที่นานเกิน (วินาที)

# ── ขอบเขตข้อมูล (PDPA — เก็บ/ใช้ให้น้อยที่สุด) ───────────────
QUERY_KEY=AN                   # คีย์ค้นหาเท่านั้น: AN หรือ HN (ไม่ค้นด้วยชื่อ/บัตร ปชช.)
DATA_SCOPE=ipd                 # ipd = ผู้ป่วยใน (ค่าเริ่มต้นของการคัดกรอง)
WARD_FILTER=                   # (ถ้าต้องการ) จำกัดเฉพาะบางวอร์ด เช่น เตียงอายุรกรรม
LAB_LOOKBACK_DAYS=90           # ดึงผลแลปย้อนหลังกี่วัน (พอสำหรับคัดกรอง)
DRUG_HISTORY_DAYS=180          # ประวัติยาย้อนหลังกี่วัน

# ── การรันในเครื่อง (ปิดการเชื่อมต่อภายนอกทั้งหมด) ───────────
APP_BIND_HOST=127.0.0.1        # localhost เท่านั้น (หรือ IP LAN ของเครื่องนี้)
APP_PORT=8787
ALLOW_EXTERNAL_NETWORK=false   # true = ห้าม! ระบบนี้ทำงานได้ครบโดยไม่ต้องต่อเน็ต
DISABLE_CLOUD=true             # ปิด Firebase/AI/บริการคลาวด์ทั้งหมด

# ── ผู้ใช้งานฝั่งเภสัช (ล็อกอินในเครื่อง) ───────────────────
LOCAL_AUTH=pin                 # pin / ldap(ภายใน รพ.)  — ไม่ใช้บัญชีคลาวด์
SESSION_TIMEOUT_MIN=30

# ── บันทึก/ตรวจสอบ (เก็บในเครื่องเท่านั้น) ──────────────────
LOG_QUERIES=true               # เก็บ log ทุก query เพื่อให้ IT audit
LOG_DIR=./logs
SCREEN_RESULT_STORE=sqlite     # ผลคัดกรองเก็บใน sqlite ในเครื่อง (ไม่เขียนกลับ HOSxP)
SCREEN_RESULT_RETENTION_DAYS=365
