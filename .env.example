# Firebase config — สร้าง project ใหม่ที่ https://console.firebase.google.com แล้ว copy values มาวาง
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Anthropic API key — กรอกผ่านหน้า Settings ของแอป (เก็บใน Firestore CONFIG/anthropic)
# อย่ากรอกที่นี่ ถ้าใช้ shared device
